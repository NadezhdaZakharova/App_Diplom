<?xml version="1.0" encoding="utf-8"?>
<!--
  Автобэкап (до API 31) и совместимость: только данные приложения в diplom.db (+ WAL/SHM рядом).
  База WorkManager не бэкапится — при восстановлении расписание пересоздаётся в MainActivity
  (иначе возможны дубликаты periodic work и рассинхрон).
  Кэш и прочие файлы в files/ не включаем — предсказуемый объём и меньше мусора в облаке.
  См. https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="database" path="." />
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
</full-backup-content>
